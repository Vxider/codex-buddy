{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/codex-buddy hook session-start --config ~/.config/codex-buddy/config.json",
            "statusMessage": "codex-buddy session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/codex-buddy hook user-prompt-submit --config ~/.config/codex-buddy/config.json"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/codex-buddy hook pre-tool-use --config ~/.config/codex-buddy/config.json"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/codex-buddy hook post-tool-use --config ~/.config/codex-buddy/config.json"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/codex-buddy hook stop --config ~/.config/codex-buddy/config.json"
          }
        ]
      }
    ]
  }
}
